/*
 * OmicsFlow Nextflow Configuration for Sugon NIDVD HPC Cluster
 * 
 * Cluster: Sugon (NIDVD HPC)
 * Scheduler: PBS/Torque
 * 
 * Node types:
 *   compute   : computer[1-4]  - AMD EPYC 7763, 64C, 1TB RAM
 *   gpu_a40   : gpu[1-9]       - Intel Xeon Gold 6326, 16C, 512G, 4×A40
 *   gpu_3090  : gpu[10-17]     - Intel Xeon Gold 5317, 12C, 256G, 4/8×RTX3090
 *   gpu_z100l : gpu18          - Intel Xeon Gold 5317, 12C, 256G, 2×Z100L
 */

params {
    singularity_cache = "/data/singularity"
    output_dir = "./results"
}

process {
    executor = 'pbs'
    
    // Default: CPU compute nodes
    clusterOptions = '-q batch -l nodes=1:ppn=8 -l mem=32gb'
    
    // Singularity for all processes
    containerOptions = '--bind /data:/data --bind /public:/public'
    
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors = 3
}

// Process-specific resource profiles
profiles {
    compute {
        process {
            executor = 'pbs'
            clusterOptions = '-q batch'
        }
    }
    
    gpu_a40 {
        process {
            executor = 'pbs'
            clusterOptions = '-q gpu -l nodes=1:ppn=8 -l mem=64gb -l ngpus=1'
        }
    }
    
    gpu_3090 {
        process {
            executor = 'pbs'
            clusterOptions = '-q gpu -l nodes=1:ppn=8 -l mem=32gb -l ngpus=1'
        }
    }
    
    // CPU-intensive processes
    high_cpu {
        process {
            cpus = 32
            memory = '128 GB'
            time = '72h'
            clusterOptions = '-q batch -l nodes=1:ppn=32 -l mem=128gb -l walltime=72:00:00'
        }
    }
    
    medium_cpu {
        process {
            cpus = 16
            memory = '64 GB'
            time = '48h'
            clusterOptions = '-q batch -l nodes=1:ppn=16 -l mem=64gb -l walltime=48:00:00'
        }
    }
    
    light {
        process {
            cpus = 4
            memory = '16 GB'
            time = '4h'
            clusterOptions = '-q batch -l nodes=1:ppn=4 -l mem=16gb -l walltime=04:00:00'
        }
    }
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = params.singularity_cache
}

executor {
    $pbs {
        name = 'pbs'
        queueSize = 50
        submitRateLimit = '10 sec'
    }
}

// Report
report {
    enabled = true
    file = "${params.output_dir}/nextflow_report.html"
}

trace {
    enabled = true
    file = "${params.output_dir}/nextflow_trace.txt"
    fields = 'task_id,hash,process,tag,name,status,exit,realtime,%cpu,%mem,rss'
}

timeline {
    enabled = true
    file = "${params.output_dir}/nextflow_timeline.html"
}